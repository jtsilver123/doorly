# Supabase — Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>

# RealtyAPI (realtyapi.io). One key covers StreetEasy, Zillow, HotPads, Realtor.
# Without it only Craigslist works.
REALTYAPI_KEY=

# Shared secret for the scheduled poll endpoint. Any random string.
CRON_SECRET=
