# --- Supabase (required) ---------------------------------------------------
# Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>

# Project Settings -> API Keys -> service_role. SERVER ONLY — never expose this
# to the browser. Scraping needs it: shared market data is written once for
# everyone, which RLS deliberately forbids to normal users.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Listing data ----------------------------------------------------------
# realtyapi.io. One key covers StreetEasy, Zillow, Apartments.com and HotPads.
# Without it only Craigslist works. Can also be set in-app under My details,
# which takes precedence — handy when a trial key runs out.
REALTYAPI_KEY=

# --- Scheduled polling -----------------------------------------------------
# Any random string. Required in production; protects /api/cron/poll.
CRON_SECRET=
