{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "damnlease",
  // Wraps OpenNext's generated worker to add the cron handler — see the file.
  "main": "worker-entry.js",
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "compatibility_date": "2026-01-01",
  // nodejs_compat is not optional here: the app uses AsyncLocalStorage to
  // carry the acting user's API key through a poll, and web-push signs VAPID
  // with node crypto. Both come from this flag.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // One address. The account's workers.dev subdomain would otherwise serve a
  // second, public copy of the whole app at damnlease.<account>.workers.dev —
  // duplicate content, and a URL that leaks the account name.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Tour footage. Video is the one thing here that's genuinely big and
  // genuinely re-watched, which is exactly R2's shape: cheap to store and
  // free to serve back.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "damnlease-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
